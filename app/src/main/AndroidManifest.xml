<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DyslexiaBuddy">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DyslexiaBuddy.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.WelcomeActivity" android:exported="false" />
        <activity android:name=".activities.LanguageActivity" android:exported="false" />
        <activity android:name=".activities.MainActivity" android:exported="false" />
        <activity android:name=".activities.TracingActivity" android:exported="false" />
        <activity android:name=".activities.SettingsActivity" android:exported="false" />
        <activity android:name=".games.SoundDetectiveActivity" android:exported="false" />
        <activity android:name=".games.LetterMatchActivity" android:exported="false" />

    </application>

</manifest>
